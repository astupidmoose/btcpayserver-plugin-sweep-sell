@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.SweepSell.Controllers
@using BTCPayServer.Plugins.SweepSell.Conversion
@using BTCPayServer.Plugins.SweepSell.Settings
@using BTCPayServer.Plugins.SweepSell.Hedging
@model SweepSellSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("SWEEP-SELL", "Sweep & Sell"));
    Layout = "_Layout";
    var storeId = Context.GetRouteValue("storeId");
}

<partial name="_StatusMessage" />

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <p class="text-secondary">
            Sweep this store's wallets to your exchange and sell what comes in. Connect an exchange here first;
            the features below use it.
            To withdraw from the exchange to an account you saved there, see
            <a asp-controller="UISweepSellPayout" asp-action="Payout" asp-route-storeId="@storeId" id="PayoutLink">Payout</a>.
        </p>
        @if (!ViewContext.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="text-danger"></div>
        }
        <form method="post" asp-action="Settings" asp-route-storeId="@storeId" novalidate>
            <div class="d-flex align-items-center mt-2 mb-4">
                <input asp-for="Paused" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="Paused" class="form-check-label"></label>
                    <div class="form-text mt-0">When on, nothing is swept, sold or paid out for this store. Your settings are kept.</div>
                </div>
            </div>

            <h4 class="mt-4 mb-2">Exchange</h4>
            <div class="form-group">
                <label asp-for="ExchangeId" class="form-label"></label>
                <select asp-for="ExchangeId" class="form-select">
                    <option value="">None</option>
                    @foreach (var exchange in Model.Exchanges)
                    {
                        <option value="@exchange.Id">@exchange.Name</option>
                    }
                </select>
                <span asp-validation-for="ExchangeId" class="text-danger"></span>
                @foreach (var exchange in Model.Exchanges)
                {
                    <div class="form-text">@exchange.Name: @exchange.KeyPermissionsHelp</div>
                }
            </div>
            @if (Model.CredentialsUnreadable)
            {
                <div class="alert alert-warning" role="alert">
                    The saved key can't be read on this server (its encryption keys changed, e.g. after a restore). Enter the API key and private key again.
                </div>
            }
            <div class="form-group">
                <label asp-for="ApiKey" class="form-label"></label>
                <input asp-for="ApiKey" type="password" class="form-control" autocomplete="off" spellcheck="false"
                       placeholder="@(Model.HasCredentials ? "Saved. Leave empty to keep it." : "")" value="" />
            </div>
            <div class="form-group">
                <label asp-for="ApiSecret" class="form-label"></label>
                <input asp-for="ApiSecret" type="password" class="form-control" autocomplete="off" spellcheck="false"
                       placeholder="@(Model.HasCredentials ? "Saved. Leave empty to keep it." : "")" value="" />
                <div class="form-text">Stored encrypted on this server and never shown again. Changing the exchange removes the saved key.</div>
                <span asp-validation-for="ApiSecret" class="text-danger"></span>
            </div>
            @if (Model.HasCredentials)
            {
                <div class="form-check mb-3">
                    <input asp-for="ClearCredentials" type="checkbox" class="form-check-input" />
                    <label asp-for="ClearCredentials" class="form-check-label"></label>
                </div>
            }
            <h4 class="mt-5 mb-2">Sweep to the exchange</h4>
            <p class="text-secondary">
                Sends a hot wallet's balance to your exchange as soon as it reaches the minimum you set, optionally with a share to
                your cold wallet. The exchange's deposit address is read with the saved key, and the deposit is converted as soon as
                the exchange credits it. Only hot wallets (whose private key is on this server) can be swept.
            </p>
            @if (!Model.CanSpend)
            {
                <div class="alert alert-info" role="alert">
                    You can see these settings but not change them, or the exchange key while sweeping is on: that needs permission to sign
                    and broadcast wallet transactions in this store.
                </div>
            }
            <div class="d-flex align-items-center mb-3">
                <input asp-for="SweepEnabled" type="checkbox" class="btcpay-toggle me-3" />
                <label asp-for="SweepEnabled" class="form-check-label"></label>
            </div>
            <span asp-validation-for="SweepEnabled" class="text-danger"></span>
            <div class="d-flex align-items-center mb-3">
                <input asp-for="SweepDryRun" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="SweepDryRun" class="form-check-label"></label>
                    <div class="form-text mt-0">Each sweep is built and signed but not broadcast. Turn this off only when the dry runs look right.</div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="SweepIntervalMinutes" class="form-label"></label>
                <input asp-for="SweepIntervalMinutes" type="number" min="@SweepSettings.MinIntervalMinutes" max="@SweepSettings.MaxIntervalMinutes" class="form-control" />
                <div class="form-text">Wallets are checked as soon as a transaction or block arrives; this regular check catches anything missed.</div>
                <span asp-validation-for="SweepIntervalMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SweepFeeTargetBlocks" class="form-label"></label>
                <input asp-for="SweepFeeTargetBlocks" type="number" min="@SweepSettings.MinFeeTargetBlocks" max="@SweepSettings.MaxFeeTargetBlocks" class="form-control" />
                <span asp-validation-for="SweepFeeTargetBlocks" class="text-danger"></span>
            </div>
            @if (Model.SweepRules.Count == 0)
            {
                <p class="text-secondary">This store has no on-chain wallet. Set one up under Wallets first.</p>
            }
            @for (var i = 0; i < Model.SweepRules.Count; i++)
            {
                var rule = Model.SweepRules[i];
                <div class="border rounded p-3 mb-3">
                    <input type="hidden" asp-for="SweepRules[i].CryptoCode" />
                    <div class="d-flex align-items-center mb-3">
                        <input asp-for="SweepRules[i].Enabled" type="checkbox" class="btcpay-toggle me-3" />
                        <div>
                            <label asp-for="SweepRules[i].Enabled" class="form-check-label">Sweep @rule.CryptoCode</label>
                            <div class="form-text mt-0">@rule.WalletStatus</div>
                        </div>
                    </div>
                    <span asp-validation-for="SweepRules[i].CryptoCode" class="text-danger"></span>
                    <div class="form-group">
                        <label asp-for="SweepRules[i].MinimumBalance" class="form-label">Sweep once the wallet holds (@rule.CryptoCode)</label>
                        <input asp-for="SweepRules[i].MinimumBalance" type="number" step="any" min="0" class="form-control" />
                        <div class="form-text">The exchange's minimum deposit applies too: a smaller sweep waits for more.</div>
                        <span asp-validation-for="SweepRules[i].MinimumBalance" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SweepRules[i].ColdPercent" class="form-label">Share to the cold wallet (%)</label>
                        <input asp-for="SweepRules[i].ColdPercent" type="number" step="any" min="0" max="99.99" class="form-control" />
                        <span asp-validation-for="SweepRules[i].ColdPercent" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SweepRules[i].ColdDestination" class="form-label">Cold wallet</label>
                        <input asp-for="SweepRules[i].ColdDestination" class="form-control" spellcheck="false" autocomplete="off" />
                        <div class="form-text">
                            An address, or an extended public key (xpub, ypub, zpub or a BTCPay derivation scheme) to send each sweep to a new address.
                            Check the first address against your cold wallet before turning dry run off.
                        </div>
                        <span asp-validation-for="SweepRules[i].ColdDestination" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SweepRules[i].ColdStartIndex" class="form-label">First address index (extended public key only)</label>
                        <input asp-for="SweepRules[i].ColdStartIndex" type="number" min="0" class="form-control" />
                        <div class="form-text">Skips addresses your cold wallet already used. Each sweep moves to the next one.</div>
                        <span asp-validation-for="SweepRules[i].ColdStartIndex" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SweepRules[i].DailyCap" class="form-label">Daily cap (@rule.CryptoCode)</label>
                        <input asp-for="SweepRules[i].DailyCap" type="number" step="any" min="0" class="form-control" />
                        <div class="form-text">The most to sweep per day (UTC), fee included. A larger balance is swept in parts. 0 for no cap.</div>
                        <span asp-validation-for="SweepRules[i].DailyCap" class="text-danger"></span>
                    </div>
                    <div class="form-check">
                        <input asp-for="SweepRules[i].IncludeUnconfirmed" type="checkbox" class="form-check-input" />
                        <label asp-for="SweepRules[i].IncludeUnconfirmed" class="form-check-label">Also sweep unconfirmed coins</label>
                        <div class="form-text">Off: only confirmed coins are swept.</div>
                    </div>
                </div>
            }

            <h4 class="mt-5 mb-2">Hedge on payment</h4>
            <p class="text-secondary">
                When an invoice is paid, sells the BTC it brought in on your exchange straight away, to lock in the price. Each invoice
                is hedged once. Sells come from BTC already on the exchange and never borrow: when there isn't enough there yet (for
                example until a sweep arrives), the hedge waits. Amounts below the exchange's minimum order wait until they add up.
            </p>
            <div class="d-flex align-items-center mb-3">
                <input asp-for="HedgeEnabled" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="HedgeEnabled" class="form-check-label"></label>
                    <div class="form-text mt-0">
                        @(Model.HedgeEnabledSince is { } since ? $"Covers invoices created since {since:u}." : "Covers invoices created from when you turn it on.")
                    </div>
                </div>
            </div>
            <span asp-validation-for="HedgeEnabled" class="text-danger"></span>
            <div class="d-flex align-items-center mb-3">
                <input asp-for="HedgeDryRun" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="HedgeDryRun" class="form-check-label"></label>
                    <div class="form-text mt-0">Each order is checked with the exchange but not placed. Invoices taken in dry run are never sold later.</div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="HedgeTrigger" class="form-label"></label>
                <select asp-for="HedgeTrigger" class="form-select">
                    <option value="@HedgeTrigger.Processing">Paid in full (Processing), before its payments confirm</option>
                    <option value="@HedgeTrigger.Settled">Settled</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="HedgeAmount" class="form-label"></label>
                <select asp-for="HedgeAmount" class="form-select">
                    <option value="@HedgeAmount.BtcPaid">The BTC its payments brought in (on-chain and Lightning)</option>
                    <option value="@HedgeAmount.InvoiceValue">The invoice's whole price in BTC, however it was paid</option>
                </select>
                <div class="form-text">With the first option, coins other than BTC are left to Convert at the exchange.</div>
            </div>
            <div class="form-group">
                <label asp-for="HedgeMarkets" class="form-label"></label>
                <input asp-for="HedgeMarkets" class="form-control" placeholder="GBP=CAD, EUR=CAD" spellcheck="false" />
                <div class="form-text">What to sell BTC for, by invoice currency, when it isn't the invoice currency itself.</div>
                <span asp-validation-for="HedgeMarkets" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HedgeDefaultMarket" class="form-label"></label>
                <input asp-for="HedgeDefaultMarket" class="form-control" spellcheck="false" />
                <div class="form-text">For currencies not listed above. Leave empty to sell into each invoice's own currency. BTC-priced invoices need one; those paid before it is set aren't hedged.</div>
                <span asp-validation-for="HedgeDefaultMarket" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HedgeMaxSlippagePercent" class="form-label"></label>
                <input asp-for="HedgeMaxSlippagePercent" type="number" step="0.1" min="@ConvertSettings.MinSlippageLimit" max="@ConvertSettings.MaxSlippageLimit" class="form-control" />
                <div class="form-text">Orders sell right away at this price or better; whatever can't fill is cancelled and tried again later.</div>
                <span asp-validation-for="HedgeMaxSlippagePercent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HedgeDailyCap" class="form-label"></label>
                <input asp-for="HedgeDailyCap" type="number" step="any" min="0" class="form-control" />
                <div class="form-text">The most BTC to sell per day (UTC). Invoices over it wait for the next day. 0 for no cap.</div>
                <span asp-validation-for="HedgeDailyCap" class="text-danger"></span>
            </div>

            <h4 class="mt-5 mb-2">Convert at the exchange</h4>
            <p class="text-secondary">
                Sells everything available of the coins you list for the coin you convert to, as soon as it clears the
                exchange's minimum order. Coins below the minimum wait on the exchange until more arrive.
            </p>
            <div class="d-flex align-items-center mb-3">
                <input asp-for="ConvertEnabled" type="checkbox" class="btcpay-toggle me-3" />
                <label asp-for="ConvertEnabled" class="form-check-label"></label>
            </div>
            <span asp-validation-for="ConvertEnabled" class="text-danger"></span>
            <div class="d-flex align-items-center mb-3">
                <input asp-for="ConvertDryRun" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="ConvertDryRun" class="form-check-label"></label>
                    <div class="form-text mt-0">Each order is checked with the exchange but not placed. Turn this off only when the dry runs look right.</div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="ConvertAssets" class="form-label"></label>
                <input asp-for="ConvertAssets" class="form-control" placeholder="DOGE, LTC" spellcheck="false" />
                <div class="form-text">Tickers, separated by commas.</div>
                <span asp-validation-for="ConvertAssets" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConvertTarget" class="form-label"></label>
                <input asp-for="ConvertTarget" class="form-control" spellcheck="false" />
                <span asp-validation-for="ConvertTarget" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConvertIntervalMinutes" class="form-label"></label>
                <input asp-for="ConvertIntervalMinutes" type="number" min="@BTCPayServer.Plugins.SweepSell.Settings.ConvertSettings.MinIntervalMinutes"
                       max="@BTCPayServer.Plugins.SweepSell.Settings.ConvertSettings.MaxIntervalMinutes" class="form-control" />
                <span asp-validation-for="ConvertIntervalMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConvertMaxSlippagePercent" class="form-label"></label>
                <input asp-for="ConvertMaxSlippagePercent" type="number" step="0.1"
                       min="@BTCPayServer.Plugins.SweepSell.Settings.ConvertSettings.MinSlippageLimit"
                       max="@BTCPayServer.Plugins.SweepSell.Settings.ConvertSettings.MaxSlippageLimit" class="form-control" />
                <div class="form-text">
                    Orders sell right away at this price or better, and whatever can't fill is cancelled, never sold lower.
                    When the best bid is below it, conversion waits.
                </div>
                <span asp-validation-for="ConvertMaxSlippagePercent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConvertDailyCap" class="form-label"></label>
                <input asp-for="ConvertDailyCap" type="number" step="any" min="0" class="form-control" />
                <div class="form-text">The most to sell per day (UTC), valued at the 24-hour average. 0 for no cap.</div>
                <span asp-validation-for="ConvertDailyCap" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" id="Save">Save</button>
        </form>
        @if (Model.HasCredentials)
        {
            <form method="post" asp-action="TestCredentials" asp-route-storeId="@storeId" class="mt-3">
                <button type="submit" class="btn btn-secondary" id="Test">Test the key</button>
                <div class="form-text">Checks each permission Sweep &amp; Sell uses. Nothing is traded: the order check is validate-only.</div>
            </form>
        }
        @if (Model.SweepEnabled && Model.CanSpend)
        {
            <form method="post" asp-action="RunSweep" asp-route-storeId="@storeId" class="mt-3">
                <button type="submit" class="btn btn-secondary" id="RunSweep">Sweep now</button>
                <div class="form-text">Runs the sweep once with the saved settings@(Model.SweepDryRun ? " (dry run: nothing is broadcast)" : "").</div>
            </form>
        }
        @if (Model.HedgeEnabled)
        {
            <form method="post" asp-action="RunHedge" asp-route-storeId="@storeId" class="mt-3">
                <button type="submit" class="btn btn-secondary" id="RunHedge">Hedge now</button>
                <div class="form-text">Looks for paid invoices and sells what is waiting, with the saved settings@(Model.HedgeDryRun ? " (dry run: nothing is sold)" : "").</div>
            </form>
        }
        @if (Model.ConvertEnabled)
        {
            <form method="post" asp-action="RunConvert" asp-route-storeId="@storeId" class="mt-3">
                <button type="submit" class="btn btn-secondary" id="RunConvert">Convert now</button>
                <div class="form-text">Runs conversion once with the saved settings@(Model.ConvertDryRun ? " (dry run: nothing is sold)" : "").</div>
            </form>
        }

        @if (Model.CopyTargets.Count > 0)
        {
            <h4 class="mt-5 mb-2">Copy to other stores</h4>
            <form method="post" asp-action="Copy" asp-route-storeId="@storeId">
                <p class="text-secondary">
                    Copies the saved sweep, hedge and convert settings to the stores you pick, replacing theirs. Every copied
                    feature starts in dry run there, and each store keeps its own pause switch, activity and payout settings.
                    Sweep rules are copied for the coins that store has a wallet for. A cold wallet given as an extended public
                    key isn't copied, since both stores would use the same addresses.
                </p>
                @foreach (var target in Model.CopyTargets)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="copyTo" value="@target.Id" id="CopyTo-@target.Id" />
                        <label class="form-check-label" for="CopyTo-@target.Id">@target.Name</label>
                    </div>
                }
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="copyKey" value="true" id="CopyKey" />
                    <label class="form-check-label" for="CopyKey">Also copy the exchange key</label>
                    <div class="form-text">Otherwise each store keeps its own key. The payout key is never copied.</div>
                </div>
                <button type="submit" class="btn btn-secondary mt-3" id="CopySettings">Copy settings</button>
            </form>
        }

        <h4 class="mt-5 mb-2">Sweep activity</h4>
        <p class="text-secondary">
            Last scheduled sweep run: @(Model.SweepLastRun?.ToString("u") ?? "never").
        </p>
        @if (Model.SweepPending.Count > 0)
        {
            <h5 class="mt-3">Pending sweeps</h5>
            <p class="text-warning">
                These sweeps were signed but their broadcast isn't confirmed. Each run looks for them and rebroadcasts the same
                transaction, which can never pay twice; nothing more of that coin is swept until they are found. Remove one only
                after checking the transaction ID in a block explorer.
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Signed (UTC)</th><th>Sweep</th><th>Transaction ID</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pending in Model.SweepPending)
                        {
                            <tr>
                                <td class="text-nowrap">@pending.CreatedAt.ToString("u")</td>
                                <td>@pending.ToExchange @pending.CryptoCode to the exchange@(pending.ToCold > 0 ? $", {pending.ToCold} {pending.CryptoCode} to the cold wallet" : ""), fee @pending.Fee</td>
                                <td><code class="text-break">@pending.Txid</code></td>
                                <td>
                                    @if (Model.CanSpend)
                                    {
                                    <form method="post" asp-action="RemovePendingSweep" asp-route-storeId="@storeId" asp-route-txid="@pending.Txid">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.SweepStopped.Count > 0)
        {
            <h5 class="mt-3">Stopped coins</h5>
            <p class="text-warning">
                A deposit of these coins failed, is being returned, or wasn't credited in time, so they aren't swept: returned funds would
                otherwise be sent straight back. Resume a coin once you have sorted the deposit out with the exchange.
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Stopped (UTC)</th><th>Coin</th><th>Transaction ID</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (coin, stopped) in Model.SweepStopped)
                        {
                            <tr>
                                <td class="text-nowrap">@stopped.At.ToString("u")</td>
                                <td>@coin</td>
                                <td><code class="text-break">@stopped.Txid</code></td>
                                <td>
                                    @if (Model.CanSpend)
                                    {
                                    <form method="post" asp-action="ResumeSweep" asp-route-storeId="@storeId" asp-route-cryptoCode="@coin">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Resume</button>
                                    </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.SweepAwaiting.Count > 0)
        {
            <h5 class="mt-3">Waiting for the exchange</h5>
            <p class="text-secondary">Sent and not credited yet. Each is converted as soon as the exchange credits it.</p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Sent (UTC)</th><th>Amount</th><th>Transaction ID</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var awaiting in Model.SweepAwaiting)
                        {
                            <tr>
                                <td class="text-nowrap">@awaiting.SentAt.ToString("u")</td>
                                <td>@awaiting.Amount @awaiting.Asset</td>
                                <td><code class="text-break">@awaiting.Txid</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.SweepActivity.Count == 0)
        {
            <p class="text-secondary">Nothing yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Time (UTC)</th><th>Coin</th><th>Result</th><th>Details</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.SweepActivity)
                        {
                            <tr>
                                <td class="text-nowrap">@entry.At.ToString("u")</td>
                                <td>@(entry.Asset ?? "")</td>
                                <td class="@(entry.Outcome == ActivityOutcome.Failed ? "text-danger" : entry.Outcome == ActivityOutcome.Sent ? "text-success" : entry.Outcome == ActivityOutcome.Changed ? "text-warning" : "")">@entry.Outcome</td>
                                <td class="text-break">@entry.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h4 class="mt-5 mb-2">Hedge activity</h4>
        <p class="text-secondary">
            Last hedge run: @(Model.HedgeLastRun?.ToString("u") ?? "never").
        </p>
        @if (Model.HedgePending.Count > 0)
        {
            <h5 class="mt-3">Pending hedge orders</h5>
            <p class="text-warning">
                These sells got no clear answer from the exchange. Each run looks them up; nothing more is hedged until they are found.
                Remove one only after checking in your exchange: it then counts as fully sold, so its invoices are never hedged twice.
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Sent (UTC)</th><th>Sell</th><th>Client order ID</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pending in Model.HedgePending)
                        {
                            <tr>
                                <td class="text-nowrap">@pending.SentAt.ToString("u")</td>
                                <td>@pending.Amount @pending.Asset for @pending.TargetAsset</td>
                                <td><code>@pending.ClientOrderId.ToString("D")</code></td>
                                <td>
                                    <form method="post" asp-action="RemovePendingHedge" asp-route-storeId="@storeId" asp-route-clientOrderId="@pending.ClientOrderId">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.HedgeQueued.Count > 0)
        {
            <h5 class="mt-3">Waiting to be sold</h5>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Invoice</th><th>BTC left to sell</th><th>For</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var queued in Model.HedgeQueued)
                        {
                            <tr>
                                <td><code>@queued.InvoiceId</code>@(queued.DryRun ? " (dry run)" : "")</td>
                                <td>@queued.Remaining of @queued.Amount</td>
                                <td>@queued.Market</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.HedgeActivity.Count == 0)
        {
            <p class="text-secondary">Nothing yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Time (UTC)</th><th>Coin</th><th>Result</th><th>Details</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.HedgeActivity)
                        {
                            <tr>
                                <td class="text-nowrap">@entry.At.ToString("u")</td>
                                <td>@(entry.Asset ?? "")</td>
                                <td class="@(entry.Outcome == ActivityOutcome.Failed ? "text-danger" : entry.Outcome == ActivityOutcome.Sold ? "text-success" : "")">@entry.Outcome</td>
                                <td class="text-break">@entry.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h4 class="mt-5 mb-2">Convert activity</h4>
        <p class="text-secondary">
            Last convert run: @(Model.ConvertLastRun?.ToString("u") ?? "never").
        </p>
        @if (Model.ConvertPending.Count > 0)
        {
            <h5 class="mt-3">Pending orders</h5>
            <p class="text-warning">
                These sells got no clear answer from the exchange. Each run looks them up; nothing more is sold until they are found.
                Remove one only after checking in your exchange whether it went through.
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Sent (UTC)</th><th>Sell</th><th>Client order ID</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pending in Model.ConvertPending)
                        {
                            <tr>
                                <td class="text-nowrap">@pending.SentAt.ToString("u")</td>
                                <td>@pending.Amount @pending.Asset for @pending.TargetAsset</td>
                                <td><code>@pending.ClientOrderId.ToString("D")</code></td>
                                <td>
                                    <form method="post" asp-action="RemovePending" asp-route-storeId="@storeId" asp-route-clientOrderId="@pending.ClientOrderId">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.ConvertActivity.Count == 0)
        {
            <p class="text-secondary">Nothing yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Time (UTC)</th><th>Coin</th><th>Result</th><th>Details</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.ConvertActivity)
                        {
                            <tr>
                                <td class="text-nowrap">@entry.At.ToString("u")</td>
                                <td>@(entry.Asset ?? "")</td>
                                <td class="@(entry.Outcome == ActivityOutcome.Failed ? "text-danger" : entry.Outcome == ActivityOutcome.Sold ? "text-success" : "")">@entry.Outcome</td>
                                <td>@entry.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
