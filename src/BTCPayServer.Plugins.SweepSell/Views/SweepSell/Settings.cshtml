@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.SweepSell.Controllers
@model SweepSellSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("SWEEP-SELL", "Sweep & Sell"));
    Layout = "_Layout";
    var storeId = Context.GetRouteValue("storeId");
}

<partial name="_StatusMessage" />

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <p class="text-secondary">
            Sweep this store's wallets to your exchange and sell what comes in. Connect an exchange here first;
            sweep rules, hedging on payment and conversion at the exchange are set up below it as they become available.
        </p>
        @if (!ViewContext.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="text-danger"></div>
        }
        <form method="post" asp-action="Settings" asp-route-storeId="@storeId" novalidate>
            <div class="d-flex align-items-center mt-2 mb-4">
                <input asp-for="Paused" type="checkbox" class="btcpay-toggle me-3" />
                <div>
                    <label asp-for="Paused" class="form-check-label"></label>
                    <div class="form-text mt-0">When on, nothing is swept or sold for this store. Your settings are kept.</div>
                </div>
            </div>

            <h4 class="mt-4 mb-2">Exchange</h4>
            <div class="form-group">
                <label asp-for="ExchangeId" class="form-label"></label>
                <select asp-for="ExchangeId" class="form-select">
                    <option value="">None</option>
                    @foreach (var exchange in Model.Exchanges)
                    {
                        <option value="@exchange.Id">@exchange.Name</option>
                    }
                </select>
                <span asp-validation-for="ExchangeId" class="text-danger"></span>
                @foreach (var exchange in Model.Exchanges)
                {
                    <div class="form-text">@exchange.Name: @exchange.KeyPermissionsHelp</div>
                }
            </div>
            @if (Model.CredentialsUnreadable)
            {
                <div class="alert alert-warning" role="alert">
                    The saved key can't be read on this server (its encryption keys changed, e.g. after a restore). Enter the API key and private key again.
                </div>
            }
            <div class="form-group">
                <label asp-for="ApiKey" class="form-label"></label>
                <input asp-for="ApiKey" type="password" class="form-control" autocomplete="off" spellcheck="false"
                       placeholder="@(Model.HasCredentials ? "Saved. Leave empty to keep it." : "")" value="" />
            </div>
            <div class="form-group">
                <label asp-for="ApiSecret" class="form-label"></label>
                <input asp-for="ApiSecret" type="password" class="form-control" autocomplete="off" spellcheck="false"
                       placeholder="@(Model.HasCredentials ? "Saved. Leave empty to keep it." : "")" value="" />
                <div class="form-text">Stored encrypted on this server and never shown again. Changing the exchange removes the saved key.</div>
                <span asp-validation-for="ApiSecret" class="text-danger"></span>
            </div>
            @if (Model.HasCredentials)
            {
                <div class="form-check mb-3">
                    <input asp-for="ClearCredentials" type="checkbox" class="form-check-input" />
                    <label asp-for="ClearCredentials" class="form-check-label"></label>
                </div>
            }
            <button type="submit" class="btn btn-primary" id="Save">Save</button>
        </form>
        @if (Model.HasCredentials)
        {
            <form method="post" asp-action="TestCredentials" asp-route-storeId="@storeId" class="mt-3">
                <button type="submit" class="btn btn-secondary" id="Test">Test the key</button>
                <div class="form-text">Checks each permission Sweep &amp; Sell uses. Nothing is traded: the order check is validate-only.</div>
            </form>
        }
    </div>
</div>
